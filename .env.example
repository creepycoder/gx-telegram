# ── GX Telegram Gateway — configuration ────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (already in .gitignore).

# ─ REQUIRED: Telegram bot (existing "inferont" bot) ─────────────────────
# From @BotFather → /token for inferont
TELEGRAM_BOT_TOKEN=

# ─ REQUIRED: security allowlists (comma-separated numeric IDs) ──────────
# Find your numeric user id by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# Default destination for notifications with no explicit chat
# (needed for outbound/scheduled notifications before the user says anything).
# Usually the same as your allowed chat id.
DEFAULT_CHAT_ID=

# ─ Routing ──────────────────────────────────────────────────────────────
DEFAULT_AGENT=gx10
# Agents whose Hermes runs on the gateway host itself (comma-separated)
LOCAL_AGENTS=gx10
# Model name shown in /status and startup notifications
LOCAL_AGENT_MODEL=Qwen3.8

# ─ Gateway HTTP bind ────────────────────────────────────────────────────
# IMPORTANT: the gateway must be reachable from SCAR16 on the LAN, so it has
# to bind a LAN-reachable address. Prefer the explicit LAN IP over 0.0.0.0.
# GX10 LAN IP is currently 192.168.1.152 (check `ip -4 addr` after DHCP changes).
# Use 0.0.0.0 only if the LAN IP changes often and you accept all-interface bind.
GATEWAY_HOST=192.168.1.152
GATEWAY_PORT=30100

# Admin token for /task*, /agents, /telegram/* HTTP endpoints and the CLI.
# Generate:  openssl rand -hex 32
# If unset, admin endpoints accept loopback requests only.
GATEWAY_ADMIN_TOKEN=

# ─ Agent-to-gateway authentication (per agent shared secret) ────────────
# Required for every REMOTE agent. Generate one per agent:
#   openssl rand -hex 32
# On the gateway:  AGENT_TOKEN_SCAR16=<secret>
# On SCAR16:       same value in its own .env
AGENT_TOKEN_SCAR16=

# ─ Heartbeats / tasks ───────────────────────────────────────────────────
HEARTBEAT_INTERVAL=30
AGENT_OFFLINE_AFTER=90
TASK_TIMEOUT=1800
MAX_CONCURRENT_TASKS=4
CONTEXT_TURNS=6

# ─ Hermes ───────────────────────────────────────────────────────────────
HERMES_BIN=hermes

# ─ Notifications / rate limiting ────────────────────────────────────────
# ignore | telegram
LOW_PRIORITY_MODE=ignore
RATE_LIMIT_PER_MINUTE=20

# ─ Storage / logging ────────────────────────────────────────────────────
DB_PATH=data/gateway.db
LOG_LEVEL=INFO
